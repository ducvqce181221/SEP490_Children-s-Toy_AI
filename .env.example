# =============================================================
# SEP490 AI Moderation Sidecar - Environment Variables Template
# Copy to .env and fill in real values. NEVER commit .env.
# =============================================================

# === Database (SQL Server) ===
MSSQL_CONNECTION_STRING=DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost;DATABASE=SEP490_ToyStore;UID=sa;PWD=yourpassword

# === LLM (separated by feature) ===
# Blog comment moderation uses DeepSeek (BLOG_DEEPSEEK_*).
BLOG_DEEPSEEK_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BLOG_DEEPSEEK_MODEL=deepseek-v4-flash
BLOG_DEEPSEEK_BASE_URL=https://api.deepseek.com
BLOG_DEEPSEEK_TEMPERATURE=0.85
BLOG_DEEPSEEK_MAX_TOKENS=2200
BLOG_DEEPSEEK_TIMEOUT_SECONDS=30
BLOG_DEEPSEEK_RETRY_ATTEMPTS=3

# Other moderation flows (non-blog) use GROQ_*.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=
GROQ_TEMPERATURE=0
GROQ_MAX_TOKENS=200

# === Google Cloud Vision ===
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_APPLICATION_CREDENTIALS_JSON=eyJ0eXBlIjog...

# === Worker Config ===
TRIGGER_MODE=POLL
POLL_INTERVAL_SECONDS=30
MAX_CONCURRENT_REVIEWS=5
MAX_RETRY_ATTEMPTS=3
MAX_FAILURE_COUNT_BEFORE_ALERT=5

# Blog comment moderation worker
BLOG_COMMENT_WORKER_ENABLED=true
BLOG_COMMENT_POLL_INTERVAL_SECONDS=30
BLOG_COMMENT_BATCH_SIZE=20
BLOG_COMMENT_MAX_CONCURRENT=5
BLOG_COMMENT_RETRY_INTERVAL_MINUTES=5
BLOG_COMMENT_MANUAL_REVIEW_TIMEOUT_HOURS=24
BLOG_COMMENT_LOCK_DAYS=7
BLOG_COMMENT_VIOLATION_WINDOW_DAYS=15
BLOG_COMMENT_VIOLATION_THRESHOLD=20

# === Image Processing Thresholds ===
IMAGE_MIN_SIZE_KB=10
IMAGE_MAX_SIZE_MB=10
IMAGE_BLUR_LV_REJECT_THRESHOLD=1.0
IMAGE_BLUR_LV_MANUAL_REVIEW_THRESHOLD=2.5

# === Business Rules ===
ACCOUNT_REJECTED_REVIEW_DAYS=30
ACCOUNT_REJECTED_REVIEW_MAX=2
LLM_CONFIDENCE_THRESHOLD=0.70

# === App ===
APP_ENV=development
LOG_LEVEL=INFO
# The backend .NET AiModeration:InternalApiKey must match this value.
AI_INTERNAL_API_KEY=change-me-to-a-secret-key
