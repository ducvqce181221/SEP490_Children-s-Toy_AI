# =============================================================
# SEP490 AI Moderation Sidecar — Environment Variables Template
# Copy to .env and fill in real values. NEVER commit .env.
# =============================================================

# === Database (SQL Server) ===
# Example local: DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost,1433;DATABASE=SEP490_ToyStore;UID=sa;PWD=YourPass
# Example Docker: DRIVER={ODBC Driver 17 for SQL Server};SERVER=sqlserver;DATABASE=SEP490_ToyStore;UID=sa;PWD=YourPass
MSSQL_CONNECTION_STRING=DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost;DATABASE=SEP490_ToyStore;UID=sa;PWD=yourpassword

# === Groq LLM ===
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0
GROQ_MAX_TOKENS=200

# === Google Cloud Vision ===
# Path to service account JSON file (local dev)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# OR base64-encoded JSON content (Docker/production, takes priority if set)
# GOOGLE_APPLICATION_CREDENTIALS_JSON=eyJ0eXBlIjog...

# === Worker Config ===
# POLL = poll DB every N seconds | OUTBOX = consume DomainEventOutbox (future)
TRIGGER_MODE=POLL
POLL_INTERVAL_SECONDS=30
MAX_CONCURRENT_REVIEWS=5
MAX_RETRY_ATTEMPTS=3
# After this many consecutive failures on the same record → ManualReview + alert
MAX_FAILURE_COUNT_BEFORE_ALERT=5

# === Image Processing Thresholds ===
# Calibrate these after collecting real production data
IMAGE_MIN_SIZE_KB=10
IMAGE_MAX_SIZE_MB=10
IMAGE_BLUR_LV_REJECT_THRESHOLD=1.0
IMAGE_BLUR_LV_MANUAL_REVIEW_THRESHOLD=2.5
IMAGE_PHASH_HAMMING_DISTANCE=10
IMAGE_PHASH_DUPLICATE_MIN_REVIEWS=5

# === Business Rules ===
# Escalate APPROVED → MANUAL_REVIEW if account had >= N rejected reviews in last D days
ACCOUNT_REJECTED_REVIEW_DAYS=30
ACCOUNT_REJECTED_REVIEW_MAX=2
# Escalate APPROVED → MANUAL_REVIEW if product was created within last N days
NEW_PRODUCT_DAYS=7
# Force MANUAL_REVIEW if LLM confidence < threshold
LLM_CONFIDENCE_THRESHOLD=0.70

# === App ===
APP_ENV=development
LOG_LEVEL=INFO
# Internal API key for /moderation/trigger endpoint (generate a random UUID)
INTERNAL_API_KEY=change-me-to-a-secret-key
